{"parentUuid":"1890fa47-63c4-4971-9738-ce3c5f5a3fd3","isSidechain":false,"promptId":"38f2d6ee-0c1d-450e-9cf6-6a64a3d1c464","type":"user","message":{"role":"user","content":[{"type":"text","text":"blubridge@blubridge:/mnt/volgrp03/3rd_floor/Adhitya/CP/Context_Parallelism$  ARCH=\"CP_SIZE=1 CP_N_EMBD=384 CP_N_LAYER=6 CP_N_HEAD=6 CP_N_KVHEAD=2 CP_FFN=1024 CP_WEIGHT_TYING=0\"0\"\nDR=/mnt/volgrp03/3rd_floor/Adhitya/CP/Context_Parallelism/Data_Loader/Data\nLD=BluTrain/Tensor-Implementations/lib:BluTrain/Profiler/lib\n# branch base 30 -> free run 300, fine-tune at 32k WITH YaRN, NO LongRoPE:\n(cd checkpoints_bluscriptcp && for f in blumodelcp_run30_*; do cp \"$f\" \"${f/run30/run300}\"; done)\nenv $ARCH CP_T=32768 CP_B=1 CP_GLOBAL_BATCH=131072 YARN_SCALE=8 YARN_ORIG_MAXPOS=4096 \\\n    CP_CKPT=1 CP_CKPT_RESUME=300 CP_MAX_STEPS=1217 CP_REWARMUP=100 CP_REWARMUP_PEAK=0.3 \\\n    CP_DATA_ROOT=$DR CUDA_VISIBLE_DEVICES=0 LD_LIBRARY_PATH=$LD \\\n    mpirun -np 1 ./build/bluscriptCP_exec\n# then eval it (YaRN, no LongRoPE):\nenv $ARCH CP_EVAL_PPL=1 CP_T=32768 CP_B=1 CP_EVAL_WINDOWS=32 YARN_SCALE=8 YARN_ORIG_MAXPOS=4096 \\\n    CP_CKPT_RESUME=300 CP_EVAL_OUT=ppl_yarn_lce_x8_32k.csv CUDA_VISIBLE_DEVICES=0 \\\n    CP_DATA_ROOT=$DR LD_LIBRARY_PATH=$LD mpirun -np 1 ./build/bluscriptCP_exec\n> ^C"}]},"uuid":"02c1d040-a40b-43ba-a141-6a0c6252b8c7","timestamp":"2026-08-04T06:14:51.880Z","permissionMode":"default","origin":{"kind":"human"},"promptSource":"sdk","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-bridge25/CP","sessionId":"3d913bc2-47ed-4031-b9d2-02eae46f0296","version":"2.1.220","gitBranch":"main","slug":"polished-cuddling-graham"}
