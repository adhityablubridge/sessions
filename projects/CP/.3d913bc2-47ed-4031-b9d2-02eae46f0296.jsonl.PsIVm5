113\t            const Dtype ydt = y_cpu.dtype();\n1114\t            const uint16_t* yp16 = (ydt == Dtype::UInt16) ? y_cpu.data<uint16_t>() : nullptr;\n1115\t            const int32_t*  yp32 = (ydt == Dtype::Int32)  ? y_cpu.data<int32_t>()  : nullptr;\n1116\t            const int64_t*  yp64 = (ydt == Dtype::Int64)  ? y_cpu.data<int64_t>()  : nullptr;\n1117\t            if (!yp16 && !yp32 && !yp64)\n1118\t                throw std::runtime_error(\"CP_EVAL_PPL: unexpected target dtype for y_local\");\n1119\t\n1120\t            // Per-position NLL[t] = logsumexp(logits[b,t]) - logits[b,t, target].\n1121\t            // Each position t is written by one iteration only (safe to OMP over t\n1122\t            // if -fopenmp is enabled; harmless no-op otherwise).\n1123\t            #pragma omp parallel for schedule(dynamic)\n1124\t            for (int t = 0; t < Tpos; ++t) {"}]},"uuid":"c8e2e037-eb69-442b-bad3-1ff5fd478379","timestamp":"2026-07-20T13:50:47.036Z","toolUseResult":{"type":"text","file":{"filePath":"/home/blu-bridge25/CP/Scripts/Blutrain/bluscriptCP.cpp","content":"\n        const int         n_windows = static_cast<int>(env_i64(\"CP_EVAL_WINDOWS\", 10));\n        const std::string out_csv   = std::getenv(\"CP_EVAL_OUT\")\n                                        ? std::getenv(\"CP_EVAL_OUT\") : \"ppl_vs_pos.csv\";\n        const int     Tpos = static_cast<int>(cfg.T);\n        const int     Bloc = static_cast<int>(cfg.B);\n        const int64_t V    = cfg.vocab_size;\n\n        if (is_master)\n            std::cout << \"[eval] PPL-vs-position: \" << n_windows << \" windows x B=\" << Bloc\n                      << \" T=\" << Tpos << \" (YARN_SCALE via env) -> \" << out_csv << std::endl;\n\n        std::vector<double>    sum_nll(static_cast<size_t>(Tpos), 0.0);\n        std::vector<long long> cnt(static_cast<size_t>(Tpos), 0);\n\n        autograd::NoGradGuard no_grad;\n        val_loader.reset();\n        for (int w = 0; w < n_windows; ++w) {\n            Batch b