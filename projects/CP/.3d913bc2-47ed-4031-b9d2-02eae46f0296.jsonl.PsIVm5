{"parentUuid":"e709b337-8882-4c1c-8960-8a490765e794","isSidechain":false,"attachment":{"type":"file","filename":"/home/blu-bridge25/CP/.mdfiles/pplevalipynb.md","content":{"type":"text","file":{"filePath":"/home/blu-bridge25/CP/.mdfiles/pplevalipynb.md","content":"# =============================================================================\n# Long-context PPL-vs-position (114M): base naive-extrapolation vs YaRN-extended.\n#\n# Produce the CSVs on the SERVER with bluscriptCP eval mode (NP=1 / CP_SIZE=1 so\n# per-position NLL needs no cross-rank gather). Eval runs on the held-out val\n# split (unseen data). Example:\n#\n#   # (A) naive baseline: BASE checkpoint, NO YaRN, at the extended T\n#   CP_EVAL_PPL=1 CP_EVAL_WINDOWS=20 CP_EVAL_OUT=ppl_base_noyarn_16384.csv \\\n#   CP_T=16384 YARN_SCALE=1 CP_CKPT_RESUME=<BASE_RUN> \\\n#   make CP_FUSED_ROPE=1 CP_SIZE=1 run-bluscript-cp NP=1\n#\n#   # (B) YaRN-extended: EXTENDED checkpoint, YaRN on, at the extended T\n#   CP_EVAL_PPL=1 CP_EVAL_WINDOWS=20 CP_EVAL_OUT=ppl_ext_yarn_16384.csv \\\n#   CP_T=16384 YARN_SCALE=4 YARN_ORIG_MAXPOS=4096 CP_CKPT_RESUME=<EXT_RUN> \\\n#   make CP_FUSED_ROPE=1 CP_SIZE=1 run-bluscript-cp NP=1\n#\n#   # (optional C) in-distribution floor: BASE checkpoint at the ORIGINAL T\n#   CP_EVAL_PPL=1 CP_EVAL_WINDOWS=20 CP_EVAL_OUT=ppl_base_4096.csv \\\n#   CP_T=4096 YARN_SCALE=1 CP_CKPT_RESUME=<BASE_RUN> \\\n#   make CP_FUSED_ROPE=1 CP_SIZE=1 run-bluscript-cp NP=1\n#\n# then scp the CSVs next to this notebook.\n# What \"worked\" looks like: (B) stays flat/low across the full 16384 while (A)\n# blows up past position ORIG_CTX. Verdict table prints the before/after ratio.\n# =============================================================================\nimport pandas as pd, numpy as np, matplotlib.pyplot as plt\n\nORIG_CTX = 4096   # pretraining context length (where naive extrapolation should break)\nCURVES = {\n    'base @16384 (no YaRN, naive extrapolation)': 'ppl_base_noyarn_16384.csv',\n    'YaRN-extended @16384':                        'ppl_ext_yarn_16384.csv',\n    # 'base @4096 (in-distribution floor)':        'ppl_base_4096.csv',\n}\n\ndef smooth(y, k=64):\n    if k <= 1 or len(y) < k: return y\n    return np.convolve(y, np.ones(k)/k, mode='same')\n\nplt.figure(figsize=(11, 6))\nfor label, path in CURVES.items():\n    try:\n        d = pd.read_csv(path)\n    except FileNotFoundError:\n        print(f'skip (not found): {path}'); continue\n    d = d[d['count'] > 0]\n    plt.plot(d['pos'], smooth(d['ppl'].values), label=label, linewidth=1.4)\n\nplt.axvline(ORIG_CTX, color='gray', linestyle='--', alpha=0.7, label=f'original ctx = {ORIG_CTX}')\nplt.yscale('log')\nplt.xlabel('token position'); plt.ylabel('perplexity (smoothed, log)')\nplt.title('Long-context PPL-vs-position (114M): YaRN vs naive extrapolation')\nplt.legend(); plt.grid(True, which='both', linestyle='-', alpha=0.3)\nplt.tight_layout(); plt.savefig('ppl_vs_position.png', dpi=120); plt.show()\n\n# verdict: mean PPL before vs after the original context length (ratio ~1 == flat == worked)\nprint(f'{\"curve\":45s}  PPL<{ORIG_CTX}    PPL>={ORIG_CTX}    ratio')\nfor label, path in CURVES.items():\n    try:\n        d = pd.read_csv(path)\n    except FileNotFoundError:\n        continue\n    d = d[d['count'] > 0]\n    before = d[d['pos'] <  ORIG_CTX]['ppl'].mean()\n    after  = d[d['pos'] >= ORIG_CTX]['ppl'].mean()\n    print(f'{label:45s}  {before:8.2f}   {after:8.2f}    {after/before:5.2f}')\n","numLines":67,"startLine":1,"totalLines":67}},"displayPath":".mdfiles/pplevalipynb.md"},"type":"attachment","uuid":"ed19d594-10b5-46ea-b2f2-3ce25dde0fb5","timestamp":"2026-07-21T13:53:44.031Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-bridge25/CP","sessionId":"3d913bc2-47ed-4031-b9d2-02eae46f0296","version":"2.1.215","gitBranch":"main","slug":"polished-cuddling-graham"}
