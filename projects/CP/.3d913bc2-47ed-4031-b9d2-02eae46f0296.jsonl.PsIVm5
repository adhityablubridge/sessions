le-GPU only for now: requires CP_SIZE=1 (got \" +\n                std::to_string(cp_size) + \")\");\n        if (yarn_scale <= 1.0)\n            die(\"CREAM requires YARN_SCALE > 1 (cache must be YaRN-scaled, got \" +\n                std::to_string(yarn_scale) + \")\");\n        if (cfg.cream_factor < 2)\n            die(\"CREAM requires integer YARN_SCALE >= 2 (got factor=\" +\n                std::to_string(cfg.cream_factor) + \")\");\n        if (cfg.cream_scaled_max % cfg.T != 0)\n            die(\"CREAM: scaled_max must be a multiple of T\");\n        if (cfg.cream_scaled_max < cfg.T)\n            die(\"CREAM: scaled_max < T\");\n    }\n\n    // The base RoPE cache is built at context_length. With CREAM the kernel-facing\n    // cache is a per-step gather of the full scaled cache, so T is legitimately\n    // decoupled from context_length -- but ONLY under CREAM. The original guard is\n    // preserved verbatim for the default (CREAM-off) path.\n    if (!cream_on) {\n        if (cfg.T != cfg.context_length)\n            die(\"T != context_length (RoPE cache is built at context_length)\");\n    }","originalFile":null,"structuredPatch":[{"oldStart":623,"oldLines":8,"newStart":623,"newLines":45,"lines":["         die(\"world_size=\" + std::to_string(world_size) + \" % CP_SIZE=\" + std::to_string(cfg.cp_size) + \" != 0\");","     const int cp_size = cfg.cp_size;","     const int dp_size = world_size / cp_size;","-    if (cfg.T != cfg.context_length)","-        die(\"T != context_length (RoPE cache is built at context_length)\");","+","+    // ---- CREAM context-extension (additive; env-resolved; single-GPU only) ----","+    if (const char* e = std::getenv(\"CP_CREAM_MODE\"))  cfg.cream_mode  = e;","+    if (const char* e = std::getenv(\"CP_CREAM_SIGMA\")) cfg.cream_sigma = std::atof(e);","+    if (const char* e = std::getenv(\"CP_CREAM_SEED\"))","+        cfg.cream_seed = static_cast<uint64_t>(std::strtoull(e, nullptr, 10));","+    const bool cream_on = (cfg.crea