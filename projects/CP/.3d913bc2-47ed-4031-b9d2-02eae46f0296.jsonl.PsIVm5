s.\",\"background_tasks\":[],\"session_crons\":[]}\n","stderr":"","exitCode":0,"command":"node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run-with-flags.js\" \"stop:check-console-log\" \"scripts/hooks/check-console-log.js\" \"standard,strict\"","durationMs":49},"type":"attachment","uuid":"33df2aff-adb7-43c6-a3c6-72fc75dd7159","timestamp":"2026-08-01T04:14:56.729Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-bridge25/CP","sessionId":"3d913bc2-47ed-4031-b9d2-02eae46f0296","version":"2.1.220","gitBranch":"main","slug":"polished-cuddling-graham"}
