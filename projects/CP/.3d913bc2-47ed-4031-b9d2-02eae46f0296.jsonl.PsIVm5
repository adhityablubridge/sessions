{"parentUuid":"4e209c19-1041-40a8-8614-a5ef577d6602","isSidechain":false,"promptId":"5f5c15a1-f104-4841-968c-d1e3de6d4476","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013C8dc5WVuSWSdnfUwdagMJ","type":"tool_result","content":"186\t\n187\t\n188\tdef CREAM(examples, **kwargs):\n189\t\n190\t    scaled_max_position_embeddings = kwargs['scaled_max_position_embeddings']\n191\t    model_max_position_embeddings = kwargs['model_max_position_embeddings']\n192\t\n193\t    input_ids = []\n194\t    position_ids = []\n195\t\n196\t    factor = scaled_max_position_embeddings // model_max_position_embeddings\n197\t    rand_num = random.randint(0, 1)\n198\t    if rand_num == 0:\n199\t        head_len = model_max_position_embeddings // 3\n200\t        tail_len = model_max_position_embeddings // 3\n201\t    else:\n202\t        head_len = 4 * factor\n203\t        tail_len = 4 * factor\n204\t\n205\t    len_chunk = model_max_position_embeddings - head_len - tail_len\n206\t    pos_ids_1 = torch.arange(0, head_len, dtype=torch.long)\n207\t    pos_ids_3 = torch.arange(factor * model_max_position_embeddings - tail_len, factor * model_max_position_embeddings, dtype=torch.long)\n208\t\n209\t    mu, sigma = 1 + factor, kwargs['sigma']\n210\t    x = np.linspace(2, factor * 2, 1000)\n211\t    cdf = 0.5 * (1 + sp.erf((x - mu) / (sigma * np.sqrt(2))))\n212\t\n213\t    for ids in examples[\"input_ids\"]:\n214\t        uniform_random = np.random.rand()\n215\t        rand_factor = np.interp(uniform_random, cdf, x).astype(int)\n216\t\n217\t        assert rand_factor in list(np.arange(2, factor * 2 + 1))\n218\t\n219\t        end_id =  random.randint(int(head_len + ((len_chunk - 1) * (rand_factor / 2))), ((rand_factor / 2) * model_max_position_embeddings) - tail_len - 1)\n220\t\n221\t        pos_ids_2 = torch.arange(end_id - (len_chunk - 1), end_id + 1, dtype=torch.long)\n222\t        pos_ids = torch.cat([pos_ids_1, pos_ids_2, pos_ids_3]).tolist()\n223\t        position_ids.append(pos_ids)\n224\t\n225\t        if end_id >= len(ids):\n226\t            input_pos_ids_2 = torch.arange(len(ids) - tail_len - (len_chunk - 1) - 1, len(ids) - tail_len, dtype=torch.long)\n227\t        else:\n228\t            input_pos_ids_2 = pos_ids_2\n229\t        input_pos_ids_3 = torch.arange(len(ids) - tail_len, len(ids), dtype=torch.long)\n230\t\n231\t        input_pos_ids = torch.cat([pos_ids_1, input_pos_ids_2, input_pos_ids_3])\n232\t        inp_ids = torch.tensor(ids)[input_pos_ids].tolist()\n233\t        input_ids.append(inp_ids)\n234\t\n235\t    model_inputs = {\"input_ids\": input_ids, \"position_ids\": position_ids, \"labels\": input_ids}\n236\t\n237\t    return model_inputs\n238\t\n239\t\n240\tdef test_preprocess_function(examples, tokenizer, inference_length):\n241\t\n242\t    inputs = examples[\"text\"]\n243\t    model_inputs = tokenizer(inputs, padding=False, truncation=True, max_length=inference_length)\n244\t    position_ids = [torch.arange(len(ids), dtype=torch.long) for ids in model_inputs[\"input_ids\"]]\n245\t    model_inputs[\"position_ids\"] = position_ids"}]},"uuid":"e4d33313-6320-4a81-92bc-a49c43fc8dc9","timestamp":"2026-07-20T13:03:47.911Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/cream_train.py","content":"\n\ndef CREAM(examples, **kwargs):\n\n    scaled_max_position_embeddings = kwargs['scaled_max_position_embeddings']\n    model_max_position_embeddings = kwargs['model_max_position_embeddings']\n\n    input_ids = []\n    position_ids = []\n\n    factor = scaled_max_position_embeddings // model_max_position_embeddings\n    rand_num = random.randint(0, 1)\n    if rand_num == 0:\n        head_len = model_max_position_embeddings // 3\n        tail_len = model_max_position_embeddings // 3\n    else:\n        head_len = 4 * factor\n        tail_len = 4 * factor\n\n    len_chunk = model_max_position_embeddings - head_len - tail_len\n    pos_ids_1 = torch.arange(0, head_len, dtype=torch.long)\n    pos_ids_3 = torch.arange(factor * model_max_position_embeddings - tail_len, factor * model_max_position_embeddings, dtype=torch.long)\n\n    mu, sigma = 1 + factor, kwargs['sigma']\n    x = np.linspace(2, factor * 2, 1000)\n    cdf = 0.5 * (1 + sp.erf((x - mu) / (sigma * np.sqrt(2))))\n\n    for ids in examples[\"input_ids\"]:\n        uniform_random = np.random.rand()\n        rand_factor = np.interp(uniform_random, cdf, x).astype(int)\n\n        assert rand_factor in list(np.arange(2, factor * 2 + 1))\n\n        end_id =  random.randint(int(head_len + ((len_chunk - 1) * (rand_factor / 2))), ((rand_factor / 2) * model_max_position_embeddings) - tail_len - 1)\n\n        pos_ids_2 = torch.arange(end_id - (len_chunk - 1), end_id + 1, dtype=torch.long)\n        pos_ids = torch.cat([pos_ids_1, pos_ids_2, pos_ids_3]).tolist()\n        position_ids.append(pos_ids)\n\n        if end_id >= len(ids):\n            input_pos_ids_2 = torch.arange(len(ids) - tail_len - (len_chunk - 1) - 1, len(ids) - tail_len, dtype=torch.long)\n        else:\n            input_pos_ids_2 = pos_ids_2\n        input_pos_ids_3 = torch.arange(len(ids) - tail_len, len(ids), dtype=torch.long)\n\n        input_pos_ids = torch.cat([pos_ids_1, input_pos_ids_2, input_pos_ids_3])\n        inp_ids = torch.tensor(ids)[input_pos_ids].tolist()\n        input_ids.append(inp_ids)\n\n    model_inputs = {\"input_ids\": input_ids, \"position_ids\": position_ids, \"labels\": input_ids}\n\n    return model_inputs\n\n\ndef test_preprocess_function(examples, tokenizer, inference_length):\n\n    inputs = examples[\"text\"]\n    model_inputs = tokenizer(inputs, padding=False, truncation=True, max_length=inference_length)\n    position_ids = [torch.arange(len(ids), dtype=torch.long) for ids in model_inputs[\"input_ids\"]]\n    model_inputs[\"position_ids\"] = position_ids","numLines":60,"startLine":186,"totalLines":378}},"sourceToolAssistantUUID":"0340cd28-18a8-46db-8f13-a4359d0e1168","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-