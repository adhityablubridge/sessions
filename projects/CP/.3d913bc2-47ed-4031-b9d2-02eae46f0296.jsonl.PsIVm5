{"parentUuid":"654a2d29-1480-49e4-85b7-c2c06d618810","isSidechain":false,"promptId":"32dd5294-a51c-4b70-b70c-e83ded2aeae2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01By8pTCeSzarLRCSxRxrVXc","type":"tool_result","content":"1\t// =============================================================================\n2\t// cp_rope_deltas_test.cpp — unit tests for the offset-based RoPE delta helper\n3\t// (Phase 1a of the CP fused-RoPE plan). Pure CPU, no CUDA, no framework.\n4\t//\n5\t// Build & run (standalone):\n6\t//   g++ -std=c++17 -I.. Tests/cp_rope_deltas_test.cpp -o /tmp/cp_rope_deltas_test \\\n7\t//       && /tmp/cp_rope_deltas_test\n8\t// (run from the CP/ repo root; -I gives access to context_parallel/RopeDeltas.h)\n9\t//\n10\t// Asserts the §\"core math\" table from the plan for N in {1,2,4}, all ranks,\n11\t// all ring steps, and all SubChunk cases, plus end-to-end global-position\n12\t// reconstruction for the canonical N=2 {0,1,6,7} example.\n13\t// =============================================================================\n14\t\n15\t#include \"context_parallel/RopeDeltas.h\"\n16\t\n17\t#include <cstdio>\n18\t#include <cstdlib>\n19\t#include <vector>\n20\t#include <set>\n21\t\n22\tusing namespace OwnTensor::cp;\n23\t\n24\tstatic int g_failures = 0;\n25\t\n26\tstatic void check_deltas(const char* tag, SdpaDeltas got,\n27\t                         int eq0, int eq1, int ek0, int ek1) {\n28\t  const bool ok = got.q.d0 == eq0 && got.q.d1 == eq1 &&\n29\t                  got.k.d0 == ek0 && got.k.d1 == ek1;\n30\t  if (!ok) {\n31\t    ++g_failures;\n32\t    std::printf(\"FAIL %-28s got q=(%d,%d) k=(%d,%d)  want q=(%d,%d) k=(%d,%d)\\n\",\n33\t                tag, got.q.d0, got.q.d1, got.k.d0, got.k.d1, eq0, eq1, ek0, ek1);\n34\t  } else {\n35\t    std::printf(\"ok   %-28s q=(%d,%d) k=(%d,%d)\\n\",\n36\t                tag, got.q.d0, got.q.d1, got.k.d0, got.k.d1);\n37\t  }\n38\t}\n39\t\n40\t// Reconstruct the global position set of a PASSED tensor of length `len`\n41\t// using the per-side delta pair and the midpoint-split rule.\n42\tstatic std::set<int> global_set(int len, Deltas d) {\n43\t  std::set<int> s;\n44\t  for (int j = 0; j < len; ++j) s.insert(rope_global_pos(j, len, d));\n45\t  return s;\n46\t}\n47\t\n48\tstatic void check_set(const char* tag, std::set<int> got, std::set<int> want) {\n49\t  if (got != want) {\n50\t    ++g_failures;\n51\t    std::printf(\"FAIL %-28s global set mismatch\\n\", tag);\n52\t  } else {\n53\t    std::printf(\"ok   %-28s global set OK\\n\", tag);\n54\t  }\n55\t}\n56\t\n57\tint main() {\n58\t  // ---- N=1 (non-CP): everything is zero ----\n59\t  check_deltas(\"N1 noncp r0 i0\", compute_deltas(0, 0, 1, 8, /*lb=*/false, SubChunk::Full),\n60\t               0, 0, 0, 0);\n61\t\n62\t  // ---- N=2 contiguous (lb=false), Tl=4 (T=8) ----\n63\t  check_deltas(\"N2 contig r0 i0\", compute_deltas(0, 0, 2, 4, false, SubChunk::Full), 0,0, 0,0);\n64\t  check_deltas(\"N2 contig r0 i1\", compute_deltas(0, 1, 2, 4, false, SubChunk::Full), 0,0, 4,4);\n65\t  check_deltas(\"N2 contig r1 i0\", compute_deltas(1, 0, 2, 4, false, SubChunk::Full), 4,4, 4,4);\n66\t  check_deltas(\"N2 contig r1 i1\", compute_deltas(1, 1, 2, 4, false, SubChunk::Full), 4,4, 0,0);\n67\t\n68\t  // ---- N=2 HeadTail LB, Tl=4, cs=2; head_base=x*2, tail_base=(3-x)*2 ----\n69\t  // rank0 shard = chunks (0,3) = global {0,1,6,7}; rank1 shard = chunks (1,2) = {2,3,4,5}\n70\t  check_deltas(\"N2 LB r0 i0 Full\",  compute_deltas(0, 0, 2, 4, true, SubChunk::Full),     0,4, 0,4);\n71\t  check_deltas(\"N2 LB r1 i0 Full\",  compute_deltas(1, 0, 2, 4, true, SubChunk::Full),     2,2, 2,2);\n72\t  // rank0 i1 -> i>rank -> QTailHalf: Q=tail(0)={6,7}, K=full source s=1={2,3,4,5}\n73\t  check_deltas(\"N2 LB r0 i1 QTail\", compute_deltas(0, 1, 2, 4, true, SubChunk::QTailHalf), 6,6, 2,2);\n74\t  // rank1 i1 -> i<=rank -> KHeadHalf: Q=full rank1, K=head(s=0)={0,1}\n75\t  check_deltas(\"N2 LB r1 i1 KHead\", compute_deltas(1, 1, 2, 4, true, SubChunk::KHeadHalf), 2,2, 0,0);\n76\t\n77\t  // ---- N=4 HeadTail LB, Tl=4, cs=2; head_base=x*2, tail_base=(7-x)*2 ----\n78\t  // rank1 shard = chunks (1,6) = {2,3,12,13}\n79\t  check_deltas(\"N4 LB r1 i0 Full\",  compute_deltas(1, 0, 4, 4, true, SubChunk::Full),     2,10, 2,10);\n80\t  // rank1 i1 -> KHeadHalf, s=(1-1)%4=0: K head(0)={0,1}\n81\t  check_deltas(\"N4 LB r1 i1 KHead\", compute_deltas(1, 1, 4, 4, true, SubChunk::KHeadHalf), 2,10, 0,0);\n82\t  // rank1 i2 -> QTailHalf, s=(1-2)%4=3: Q tail(1)={12,13}, K full source3 chunks(3,4)={6,7,8,9}->(6,6)\n83\t  check_deltas(\"N4 LB r1 i2 QTail\", compute_deltas(1, 2, 4, 4, true, SubChunk::QTailHalf), 12,12, 6,6);\n84\t\n85\t  // ---- end-to-end global-position reconstruction (the canonical example) ----\n86\t  // N=2 LB rank0 i0 Full: local [0..3] must map to global {0,1,6,7} on both sides\n87\t  {\n88\t    SdpaDeltas d = compute_deltas(0, 0, 2, 4, true, SubChunk::Full);\n89\t    check_set(\"N2 LB r0 i0 Q->{0,1,6,7}\", global_set(4, d.q), std::set<int>{0,1,6,7});\n90\t    check_set(\"N2 LB r0 i0 K->{0,1,6,7}\", global_set(4, d.k), std::set<int>{0,1,6,7});\n91\t  }\n92\t  // N2 LB r1 i0 Full -> contiguous {2,3,4,5}\n93\t  {\n94\t    SdpaDeltas d = compute_deltas(1, 0, 2, 4, true, SubChunk::Full);\n95\t    check_set(\"N2 LB r1 i0 Q->{2,3,4,5}\", global_set(4, d.q), std::set<int>{2,3,4,5});\n96\t  }\n97\t  // N2 LB r0 i1 QTail -> passed Q len 2 (tail half) -> {6,7}; K len 4 -> {2,3,4,5}\n98\t  {\n99\t    SdpaDeltas d = compute_deltas(0, 1, 2, 4, true, SubChunk::QTailHalf);\n100\t    check_set(\"N2 LB r0 i1 Qtail->{6,7}\", global_set(2, d.q), std::set<int>{6,7});\n101\t    check_set(\"N2 LB r0 i1 Kfull->{2..5}\", global_set(4, d.k), std::set<int>{2,3,4,5});\n102\t  }\n103\t  // N2 LB r1 i1 KHead -> K passed len 2 (head half of s=0) -> {0,1}\n104\t  {\n105\t    SdpaDeltas d = compute_deltas(1, 1, 2, 4, true, SubChunk::KHeadHalf);\n106\t    check_set(\"N2 LB r1 i1 Khead->{0,1}\", global_set(2, d.k), std::set<int>{0,1});\n107\t  }\n108\t  // N4 LB r1 i0 Full -> {2,3,12,13}\n109\t  {\n110\t    SdpaDeltas d = compute_deltas(1, 0, 4, 4, true, SubChunk::Full);\n111\t    check_set(\"N4 LB r1 i0 Q->{2,3,12,13}\", global_set(4, d.q), std::set<int>{2,3,12,13});\n112\t  }\n113\t\n114\t  if (g_failures == 0) {\n115\t    std::printf(\"\\nALL cp_rope_deltas tests passed.\\n\");\n116\t    return 0;\n117\t  }\n118\t  std::printf(\"\\n%d cp_rope_deltas test(s) FAILED.\\n\", g_failures);\n119\t  return 1;\n120\t}\n121\t"}]},"uuid":"07d6864f-5949-43dc-bf41-e1c3e195646f","timestamp":"2026-07-20T13:40:34.559Z","toolUseResult":{"type":"text","file":{"filePath":"/home/blu-bridge25/CP/Tests/cp_rope_deltas_test.cpp","content":"// =============================================================================\n// cp_rope_deltas_test.cpp — unit tests for the offset-based RoPE delta helper\n// (Phase 1a of the CP fused-RoPE plan). Pure CPU, no CUDA, no framework.\n//\n// Build & run (standalone):\n//   g++ -std=c++17 -I.. Tests/cp_rope_deltas_test.cpp -o /tmp/cp_rope_deltas_test \\\n//       && /tmp/cp_rope_deltas_test\n// (run from the CP/ repo root; -I gives access to context_parallel/RopeDeltas.h)\n//\n// Asserts the §\"core math\" table from the plan for N in {1,2,4}, all ranks,\n// all ring steps, and all SubChunk cases, plus end-to-end global-position\n// reconstruction for the canonical N=2 {0,1,6,7} example.\n// =============================================================================\n\n#include \"context_parallel/RopeDeltas.h\"\n\n#include <cstdio>\n#include <cstdlib>\n#include <vector>\n#include <set>\n\nusing namespace OwnTensor::cp;\n\nstatic int g_failures = 0;\n\nstatic void check_deltas(const char* tag, SdpaDeltas got,\n                         int eq0, int eq1, int ek0, int ek1) {\n  const bool ok = got.q.d0 == eq0 && got.q.d1 == eq1 &&\n                  got.k.d0 == ek0 && got.k.d1 == ek1;\n  if (!ok) {\n    ++g_failures;\n    std::printf(\"FAIL %-28s got q=(%d,%d) k=(%d,%d)  want q=(%d,%d) k=(%d,%d)\\n\",\n                tag, got.q.d0, got.q.d1, got.k.d0, got.k.d1, eq0, eq1, ek0, ek1);\n  } else {\n    std::printf(\"ok   %-28s q=(%d,%d) k=(%d,%d)\\n\",\n                tag, got.q.d0, got.q.d1, got.k.d0, got.k.d1);\n  }\n}\n\n// Reconstruct the global position set of a PASSED tensor of length `len`\n// using the per-side delta pair and the midpoint-split rule.\nstatic std::set<int> global_set(int len, Deltas d) {\n  std::set<int> s;\n  for (int j = 0; j < len; ++j) s.insert(rope_global_pos(j, len, d));\n  return s;\n}\n\nstatic void check_set(const char* tag, std::set<int> got, std::set<int> want) {\n  if (got != want) {\n    ++g_failures;\n    std::printf(\"FAIL %-28s global set mismatch\\n\", tag);\n  } else {\n    std::printf(\"ok   %-28s global set OK\\n\", tag);\n  }\n}\n\nint main() {\n  // ---- N=1 (non-CP): everything is zero ----\n  check_deltas(\"N1 noncp r0 i0\", compute_deltas(0, 0, 1, 8, /*lb=*/false, SubChunk::Full),\n               0, 0, 0, 0);\n\n  // ---- N=2 contiguous (lb=false), Tl=4 (T=8) ----\n  check_deltas(\"N2 contig r0 i0\", compute_deltas(0, 0, 2, 4, false, SubChunk::Full), 0,0, 0,0);\n  check_deltas(\"N2 contig r0 i1\", compute_deltas(0, 1, 2, 4, false, SubChunk::Full), 0,0, 4,4);\n  check_deltas(\"N2 contig r1 i0\", compute_deltas(1, 0, 2, 4, false, SubChunk::Full), 4,4, 4,4);\n  check_deltas(\"N2 contig r1 i1\", compute_deltas(1, 1, 2, 4, false, SubChunk::Full), 4,4, 0,0);\n\n  // ---- N=2 HeadTail LB, Tl=4, cs=2; head_base=x*2, tail_base=(3-x)*2 ----\n  // rank0 shard = chunks (0,3) = global {0,1,6,7}; rank1 shard = chunks (1,2) = {2,3,4,5}\n  check_deltas(\"N2 LB r0 i0 Full\",  compute_deltas(0, 0, 2, 4, true, SubChunk::Full),     0,4, 0,4);\n  check_deltas(\"N2 LB r1 i0 Full\",  compute_deltas(1, 0, 2, 4, true, SubChunk::Full),     2,2, 2,2);\n  // rank0 i1 -> i>rank -> QTailHalf: Q=tail(0)={6,7}, K=full source s=1={2,3,4,5}\n  check_deltas(\"N2 LB r0 i1 QTail\", compute_deltas(0, 1, 2, 4, true, SubChunk::QTailHalf), 6,6, 2,2);\n  // rank1 i1 -> i<=rank -> KHeadHalf: Q=full rank1, K=head(s=0)={0,1}\n  check_deltas(\"N2 LB r1 i1 KHead\", compute_deltas(1, 1, 2, 4, true, SubChunk::KHeadHalf), 2,2, 0,0);\n\n  // ---- N=4 HeadTail LB, Tl=4, cs=2; head_base=x*2, tail_base=(7-x)*2 ----\n  // rank1 shard = chunks (1,6) = {2,3,12,13}\n  check_deltas(\"N4 LB r1 i0 Full\",  compute_deltas(1, 0, 4, 4, true, SubChunk::Full),     2,10, 2,10);\n  // rank1 i1 -> KHeadHalf, s=(1-1)%4=0: K head(0)={0,1}\n  check_deltas(\"N4 LB r1 i1 KHead\", compute_deltas(1, 1, 4, 4, true, SubChunk::KHeadHalf), 2,10, 0,0);\n  // rank1 i2 -> QTailHalf, s=(1-2)%4=3: Q tail(1)={12,13}, K full source3 chunks(3,4)={6,7,8,9}->(6,6)\n  check_deltas(\"N4 LB r1 i2 QTail\", compute_deltas(1, 2, 4, 4, true, SubChunk::QTailHalf), 12,12, 6,6);\n\n  // ---- end-to-end global-position reconstruction (the canonical example) ----\n  // N=2 LB rank0 i0 Full: local [0..3] must map to global {0,1,6,7} on both sides\n  {\n    SdpaDeltas d = compute_deltas(0, 0, 2, 4, true, SubChunk::Full);\n    check_set(\"N2 LB r0 i0 Q->{0,1,6,7}\", global_set(4, d.q), std::set<int>{0,1,6,7});\n    check_set(\"N2 LB r0 i0 K->{0,1,6,7}\", global_set(4, d.k), std::set<int>{0,1,6,7});\n  }\n  // N2 LB r1 i0 Full -> contiguous {2,3,4,5}\n  {\n    SdpaDeltas d = compute_deltas(1, 0, 2, 4, true, SubChunk::Full);\n    check_set(\"N2 LB r1 i0 Q->{2,3,4,5}\", global_set(4, d.q), std::set<int>{2,3,4,5});\n  }\n  // N2 LB r0 i1 QTail -> passed Q len 2 (tail half) -> {6,7}; K len 4 -> {2,3,4,5}\n  {\n    SdpaDeltas d = compute_deltas(0, 1, 2, 4, true, SubChunk::QTailHalf);\n    check_set(\"N2 LB r0 i1 Qtail->{6,7}\", global_set(2, d.q), std::set<int>{6,7});\n    check_set(\"N2 LB r0 i1 Kfull->{2..5}\", global_set(4, d.k), std::set<int>{2,3,4,5});\n  }\n  // N2 LB r1 i1 KHead -> K passed len 2 (head half of s=0) -> {0,1}\n  {\n    SdpaDeltas d = compute_deltas(1, 1, 2, 4, true, SubChunk::KHeadHalf);\n    check_set(\"N2 LB r1 i1 Khead->{0,1}\", global_set(2, d.k), std::set<int>{0,1});\n  }\n  // N4 LB r1 i0 Full -> {2,3,12,13}\n  {\n    SdpaDeltas d = compute_deltas(1, 0, 4, 4, true, SubChunk::Full);\n    check_set(\"N4 LB r1 i0 Q->{2,3,12,13}\", global_set(4, d.q), std::set<int>{2,3,12,13});\n  }\n\n  if (g_failures == 0) {\n    std::printf(\"\\nALL cp_rope_deltas tests passed.\\n\");\n    return 0;\n  }\n  std::printf(\"\\n%d cp_rope_deltas test(s) FAILED.\\n\", g_failures);\n  return 1;\n}\n","numLines":121,"startLine":1,"totalLines":121}},"sourceToolAssistantUUID":"c870606a-9d0e-4677-b784-ffa49b00ef49","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-bridge25/CP","sessionId":"3d913bc2-47ed-4031-b9d2-02eae46f0296","version":"2.1.212","gitBranch":"main","slug":"polished-cuddling-graham"}
