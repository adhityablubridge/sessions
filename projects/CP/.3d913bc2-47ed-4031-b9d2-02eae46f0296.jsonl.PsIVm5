ys at `B=1`.\",\"background_tasks\":[],\"session_crons\":[]}\n","stderr":"","exitCode":0,"command":"node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run-with-flags.js\" \"stop:check-console-log\" \"scripts/hooks/check-console-log.js\" \"standard,strict\"","durationMs":41},"type":"attachment","uuid":"ba17f77f-3770-42fe-a38a-0d32e58b3c01","timestamp":"2026-07-22T19:15:44.127Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-bridge25/CP","sessionId":"3d913bc2-47ed-4031-b9d2-02eae46f0296","version":"2.1.216","gitBranch":"main","slug":"polished-cuddling-graham"}
