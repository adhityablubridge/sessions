  head4: [0, 1, 2, 3] mid_around: [109, 110, 111] tail4: [2044, 2045, 2046, 2047]\n  full_hash: 21283296\nCASE T=96 factor=2 branch=0 rf=4 end_id=60 len=96\n  head4: [0, 1, 2, 3] mid_around: [29, 30, 31] tail4: [188, 189, 190, 191]\n  full_hash: 537520\nCASE T=300 factor=4 branch=1 rf=6 end_id=900 len=300\n  head4: [0, 1, 2, 3] mid_around: [633, 634, 635] tail4: [1196, 1197, 1198, 1199]\n  full_hash: 38097978\n=== rand_factor_from_u golden (sigma=3.0) ===\n  u=0.01 factor=2 -> rf=2\n  u=0.01 factor=4 -> rf=2\n  u=0.01 factor=8 -> rf=2\n  u=0.25 factor=2 -> rf=2\n  u=0.25 factor=4 -> rf=2\n  u=0.25 factor=8 -> rf=6\n  u=0.5 factor=2 -> rf=3\n  u=0.5 factor=4 -> rf=5\n  u=0.5 factor=8 -> rf=9\n  u=0.75 factor=2 -> rf=4\n  u=0.75 factor=4 -> rf=7\n  u=0.75 factor=8 -> rf=11\n  u=0.99 factor=2 -> rf=4\n  u=0.99 factor=4 -> rf=8\n  u=0.99 factor=8 -> rf=15\n=== end_id_range golden ===\n  T=256 f=8 b=0 rf=8 -> (425, 938)\n  T=256 f=8 b=0 rf=7 -> (382, 810)\n  T=256 f=8 b=1 rf=5 -> (509, 607)\n  T=96 f=2 b=0 rf=4 -> (94, 159)\n  T=300 f=4 b=1 rf=7 -> (950, 1033)","stderr":"\nShell cwd was reset to /home/blu-bridge25/CP","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"ec5813ec-2aa9-46fe-87e8-8a61425ebdb6","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-bridge25/CP","sessionId":"3d913bc2-47ed-4031-b9d2-02eae46f0296","version":"2.1.212","gitBranch":"main","slug":"polished-cuddling-graham"}
