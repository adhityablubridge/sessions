\":[]}\n","stderr":"","exitCode":0,"command":"node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run-with-flags.js\" \"stop:check-console-log\" \"scripts/hooks/check-console-log.js\" \"standard,strict\"","durationMs":50},"type":"attachment","uuid":"1c1bbe04-1e6d-4ec8-8d9c-e53f974c6d89","timestamp":"2026-08-03T14:25:25.622Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-bridge25/CP","sessionId":"3d913bc2-47ed-4031-b9d2-02eae46f0296","version":"2.1.220","gitBranch":"main","slug":"polished-cuddling-graham"}
