{"parentUuid":"8c4e0a57-6812-44b9-b06d-d7f3a3c210f7","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01SQJgS6fDMUqn1JwVyZCLyF","hookEvent":"PostToolUse","content":"","stdout":"{\"session_id\":\"7f89f0ac-da79-42e5-975f-b63bab3c65d2\",\"transcript_path\":\"/home/blu-bridge25/.claude/projects/-home-blu-bridge25-CP/7f89f0ac-da79-42e5-975f-b63bab3c65d2.jsonl\",\"cwd\":\"/home/blu-bridge25/CP\",\"prompt_id\":\"32dd5294-a51c-4b70-b70c-e83ded2aeae2\",\"permission_mode\":\"acceptEdits\",\"effort\":{\"level\":\"high\"},\"hook_event_name\":\"PostToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"cd /tmp && python3 -c \\\"\\ndef h(T,factor,branch,eid):\\n    head=tail=(T//3) if branch==0 else 4*factor\\n    len_chunk=T-head-tail\\n    L=list(range(0,head))+list(range(eid-(len_chunk-1),eid+1))+list(range(factor*T-tail,factor*T))\\n    return len(L), sum((i+1)*v for i,v in enumerate(L)), L[0], L[-1], all(L[i]>L[i-1] for i in range(1,len(L)))\\nprint('96,2,0,120 ->', h(96,2,0,120))\\nprint('256,8,1,300 ->', h(256,8,1,300))\\n\\\"\",\"description\":\"Recompute golden hash for valid end_id\"},\"tool_response\":{\"stdout\":\"96,2,0,120 -> (96, 630640, 0, 191, True)\\n256,8,1,300 -> (256, 21283296, 0, 2047, True)\",\"stderr\":\"\\nShell cwd was reset to /home/blu-bridge25/CP\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false},\"tool_use_id\":\"toolu_01SQJgS6fDMUqn1JwVyZCLyF\",\"duration_ms\":17}\n","stderr":"","exitCode":0,"command":"node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run-with-flags.js\" \"post:bash:pr-created\" \"scripts/hooks/post-bash-pr-created.js\" \"standard,strict\"","durationMs":38},"type":"attachment","uuid":"24c70503-143e-4738-8215-66a2c3b226ae","timestamp":"2026-07-20T13:45:59.090Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/blu-bridge25/CP","sessionId":"3d913bc2-47ed-4031-b9d2-02eae46f0296","version":"2.1.212","gitBranch":"main","slug":"polished-cuddling-grah